<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="act-map scripts/build-trail.mjs"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Arctic Circle Trail - Northern Route</name>
    <desc>Sisimiut to Kangerlussuaq, 161.9 km. Track, 11 huts, 6 access/SAR points and 160 1 km distance marks. Source: arcticcircletrail.gl interactive map.</desc>
    <link href="https://arcticcircletrail.gl/planning/act-interactive-map/"><text>arcticcircletrail.gl</text></link>
  </metadata>
  <wpt lat="66.920334" lon="-51.360867">
    <name>Katiffik</name>
    <desc>Sleeps: 6 (max) GPS: 66.920334 -51.360867 Features: &amp;bullet; Small bench for cooking &amp;bullet; Outdoor dry toilet &amp;bullet; Great view of Amitsorsuaq Lake &amp;bullet; Look for canoes here</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.921463" lon="-51.747997">
    <name>Canoe Centre</name>
    <desc>Sleeps: 21 beds + extra space GPS: 66.921463 -51.747997 Features: &amp;bullet; Large kitchen and living area &amp;bullet; 2 separate dormitories &amp;bullet; Dry toilet &amp;bullet; Charging station &amp;bullet; Great view of Amitsorsuaq Lake &amp;bullet; Look for canoes here</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.971863" lon="-52.170223">
    <name>Ikkattooq</name>
    <desc>Sleeps: 6 (max) GPS: 66.971863 -52.170223 Features: &amp;bullet; Small bench for cooking</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.995605" lon="-52.356991">
    <name>Eqalugaarniarfik</name>
    <desc>Sleeps: 4 beds + extra space GPS: 66.995605 -52.356991 Features: &amp;bullet; Mid-sized cooking and eating area &amp;bullet; Look for instructions in the hut for on where to source water nearby</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="67.056667" lon="-52.614664">
    <name>Innajuatooq I</name>
    <desc>Sleeps: 6 (max) GPS: 67.056667 -52.614664 Features: &amp;bullet; Small bench for cooking</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="67.056519" lon="-52.628017">
    <name>Innajuatooq II</name>
    <desc>Sleeps: 10 beds + extra space GPS: 67.056519 -52.628017 Features: &amp;bullet; Large cooking and eating area &amp;bullet; Beautiful view of the lake &amp;bullet; Dry Toilet</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="67.005844" lon="-52.965691">
    <name>Nerumaq</name>
    <desc>Sleeps: 6 (max) GPS: 67.005844 -52.965691 Features: &amp;bullet; Small bench for cooking</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.9879" lon="-53.205986">
    <name>Kangerluarsuk Tulleq Nord</name>
    <desc>Sleeps: 6 beds + extra space GPS: 66.9879 -53.205986 Features: &amp;bullet; Large cooking and eating area &amp;bullet; Right on the fjord edge &amp;bullet; Optional excursion across the tidal river to the summer homes and a second valley</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.98024" lon="-53.251228">
    <name>Kangerluarsuk Tulleq Syd</name>
    <desc>Sleeps: 6 (max) GPS: 66.98024 -53.251228 Features: &amp;bullet; Small bench for cooking</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.92108" lon="-53.07003">
    <name>Uttoqqaat</name>
    <desc>Sleeps: 6 (max) GPS: 66.92108, -53.07003 Features: &amp;bullet; Small bench for cooking &amp;bullet; Located ~1km off the trail &amp;bullet; Not strictly a trail hut &amp;bullet; Often used by fishermen</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="66.93645" lon="-52.5876">
    <name>Ilagassat</name>
    <desc>Sleeps: 6 (max) GPS: 66.93645, -52.58760 Features: &amp;bullet; Small bench for cooking &amp;bullet; Outdoor dry toilet</desc>
    <sym>Lodge</sym>
    <type>Hut</type>
  </wpt>
  <wpt lat="67.15217" lon="-50.048">
    <name>SAR Point 660</name>
    <desc>Access / SAR point. Exact location along the road to be discussed directly with operator. Operators: Albatros Arctic Circle, Arctic Ice Tours, Kang Mini Tours, Tundra Adventures.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
  <wpt lat="67.09408" lon="-50.27197">
    <name>SAR Russell Glacier</name>
    <desc>Access / SAR point. Exact location along the road to be discussed directly with operator. Operators: Albatros Arctic Circle, Arctic Ice Tours, Kang Mini Tours, Tundra Adventures.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
  <wpt lat="66.99188" lon="-50.96519">
    <name>SAR Kellyville</name>
    <desc>Access / SAR point. Exact location along the road to be discussed directly with operator. Operators: Albatros Arctic Circle, Arctic Ice Tours, Kang Mini Tours, Tundra Adventures.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
  <wpt lat="66.98831" lon="-52.41706">
    <name>SAR Eqalugaarniarfik</name>
    <desc>Access / SAR point. Exact pickup/drop-off location depends on tides. Discuss directly with operator. You will need to be at the water. Operators: Backcountry Greenland Tours, Hotel SØMA Sisimiut, ISI4U, Qingalik Cruises, Sisimiut Private Boat Safari.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
  <wpt lat="66.906271" lon="-52.870116">
    <name>SAR Sarfannguit</name>
    <desc>Access / SAR point. Exact pickup/drop-off location depends on tides. Discuss directly with operator. You will need to be at the water. Operators: Backcountry Greenland Tours, Hotel SØMA Sisimiut, ISI4U, Qingalik Cruises, Sisimiut Private Boat Safari. NOTE: source popup states 66.90408, -52.85428 — 732 m from this position.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
  <wpt lat="66.98848" lon="-53.20541">
    <name>SAR Kangerluarsuk Tulleq Nord</name>
    <desc>Access / SAR point. Exact pickup/drop-off location depends on tides. Discuss directly with operator. You will need to be at the water. Operators: Backcountry Greenland Tours, Hotel SØMA Sisimiut, ISI4U, Qingalik Cruises, Sisimiut Private Boat Safari.</desc>
    <sym>Flag, Blue</sym>
    <type>Access / SAR point</type>
  </wpt>
